{
  "name": "vscode-rg-anywhere",
  "displayName": "RG Anywhere",
  "description": "ripgrep search across any folder, not limited to workspace",
  "version": "0.1.0",
  "publisher": "ericlight0025",
  "engines": { "vscode": "^1.85.0" },
  "categories": ["Other"],
  "license": "Polyform-Noncommercial-1.0.0",
  "keywords": ["ripgrep", "search", "grep", "find"],
  "activationEvents": [],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "rgAnywhere.open",
        "title": "RG Anywhere: Open Search Panel",
        "category": "RG Anywhere"
      }
    ],
    "keybindings": [
      {
        "command": "rgAnywhere.open",
        "key": "ctrl+alt+r",
        "mac": "cmd+alt+r"
      }
    ],
    "configuration": {
      "title": "RG Anywhere",
      "properties": {
        "rgAnywhere.defaultIncludeGlob": {
          "type": "string",
          "default": "",
          "description": "Default include glob pattern (e.g. *.{ts,js,py})"
        },
        "rgAnywhere.defaultExcludeGlob": {
          "type": "string",
          "default": "",
          "description": "Default exclude glob pattern (e.g. node_modules,dist)"
        },
        "rgAnywhere.defaultSort": {
          "type": "string",
          "default": "hits-desc",
          "enum": ["hits-desc", "hits-asc", "name-asc", "name-desc"],
          "enumDescriptions": [
            "Hits descending",
            "Hits ascending",
            "Filename A→Z",
            "Filename Z→A"
          ],
          "description": "Default sort order for search results"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./ && node scripts/copy-webview.js",
    "watch": "tsc -watch -p ./",
    "lint": "eslint src --ext ts"
  },
  "dependencies": {
    "@vscode/ripgrep": "^1.15.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.85.0",
    "typescript": "^5.3.0"
  }
}
